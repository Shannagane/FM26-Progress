{
  "name": "fm26-progress-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "electron:start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "flag-icons": "^7.5.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.1"
  },
  "build": {
    "appId": "com.fm26.progresstracker",
    "productName": "FM26 Progress Tracker",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico"
    },
    "portable": {
      "artifactName": "FM26-Progress-V.0.1.exe"
    }
  }
}
